<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

    <mirrors>
        <mirror>
            <id>maven-default-http-blocker</id>
            <name>Штатный блокировщик http-репозиториев отключён: Nexus контура работает по http</name>
            <mirrorOf>dummy</mirrorOf>
            <url>http://0.0.0.0/</url>
            <blocked>false</blocked>
        </mirror>
        <mirror>
            <id>inversion-repo</id>
            <url>http://vcontrol.corp.inversion.ru:8081/repository/maven-public/</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <id>default</id>
            <pluginRepositories>
                <pluginRepository>
                    <id>plugins</id>
                    <url>http://vcontrol.corp.inversion.ru:8081/repository/inversion-maven-plugins-releases/</url>
                </pluginRepository>
            </pluginRepositories>
            <repositories>
                <repository>
                    <id>inversion-releases</id>
                    <url>http://vcontrol.corp.inversion.ru:8081/repository/inversion-releases/</url>
                </repository>
                <repository>
                    <id>maven-public</id>
                    <name>maven-public</name>
                    <url>http://vcontrol.corp.inversion.ru:8081/repository/maven-public/</url>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>default</activeProfile>
    </activeProfiles>

</settings>
