# Переменные подстановки compose. На кулане приходят из CI/CD-переменных группы GitLab edo.

# Учётка mi-edo в RabbitMQ и MinIO стенда, общая с mi и mi-infra
MI_TRANSPORT_PASSWORD=mi-dev

# Учётка базы ЦАБС pgdev
XXL_DB_USER=
XXL_DB_PASSWORD=

# Пароль учётки cbsbus в шине ЦАБС
XXL_CBSBUS_PASSWORD=
