# Локальные параметры docker compose. Настройки источников БД/RabbitMQ читаются из внешнего PG YAML.
# В CI значения поступают из переменных GitLab.

# Учётка mi-edo в RabbitMQ/MinIO
MI_TRANSPORT_PASSWORD=

# ЦАБС PostgreSQL (существующие имена переменных deploy)
XXL_DB_URL=
XXL_DB_USER=
XXL_DB_PASSWORD=

# Шина ЦАБС PG: по умолчанию используется известный PG vhost из compose.yaml.
XXL_CBSBUS_ADDRESSES=amqp://rabbit.corp.inversion.ru:5672/cbsbus_pg
XXL_CBSBUS_USERNAME=cbsbus
XXL_CBSBUS_PASSWORD=
